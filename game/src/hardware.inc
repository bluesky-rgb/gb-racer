DEF rTAC   EQU $FF07
DEF rIF    EQU $FF0F
DEF rNR10  EQU $FF10
DEF rNR11  EQU $FF11
DEF rNR12  EQU $FF12
DEF rNR13  EQU $FF13
DEF rNR14  EQU $FF14
DEF rNR21  EQU $FF16
DEF rNR22  EQU $FF17
