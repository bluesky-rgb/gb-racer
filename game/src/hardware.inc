DEF rNR24  EQU $FF19
DEF rNR30  EQU $FF1A
DEF rNR31  EQU $FF1B
DEF rNR32  EQU $FF1C
DEF rNR33  EQU $FF1D
DEF rNR34  EQU $FF1E
DEF rNR41  EQU $FF20
