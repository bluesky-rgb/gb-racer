DEF rROMB0 EQU $2000        ; MBC5 ROM bank (low 8 bits)

; LCDC bits
DEF LCDC_ON      EQU %10000000
DEF LCDC_WINMAP  EQU %01000000   ; window uses $9C00
DEF LCDC_WINON   EQU %00100000
DEF LCDC_BG8000  EQU %00010000
DEF LCDC_BGMAP   EQU %00001000
DEF LCDC_OBJ16   EQU %00000100
DEF LCDC_OBJON   EQU %00000010
DEF LCDC_BGON    EQU %00000001

DEF STAT_LYC     EQU %01000000
DEF STAT_MODE0   EQU %00001000

DEF IE_VBLANK    EQU %00000001
DEF IE_STAT      EQU %00000010

; joypad bits as stored in hKeys (1 = pressed)
DEF KEY_A        EQU %00000001
DEF KEY_B        EQU %00000010
DEF KEY_SELECT   EQU %00000100
DEF KEY_START    EQU %00001000
DEF KEY_RIGHT    EQU %00010000
DEF KEY_LEFT     EQU %00100000
DEF KEY_UP       EQU %01000000
DEF KEY_DOWN     EQU %10000000
DEF KEYB_A       EQU 0
DEF KEYB_B       EQU 1
DEF KEYB_SELECT  EQU 2
DEF KEYB_START   EQU 3
DEF KEYB_RIGHT   EQU 4
DEF KEYB_LEFT    EQU 5
DEF KEYB_UP      EQU 6
DEF KEYB_DOWN    EQU 7

; OAM attribute bits
DEF OAM_BEHIND   EQU %10000000
DEF OAM_YFLIP    EQU %01000000
DEF OAM_XFLIP    EQU %00100000
DEF OAM_PAL1     EQU %00010000
